[DEFAULT]
ignoreip = 127.0.0.1/8 ::1

[recidive]
enabled = true
backend = auto

{{#nginx}}[nginx-http-auth]
enabled   = true
backend = auto
logpath = /var/log/nginx/*error*.log

[nginx-botsearch]
enabled   = true
backend = auto
logpath = /var/log/nginx/*access*.log

[wo-wordpress]
enabled = true
backend = auto
filter = wo-wordpress
action = iptables-multiport[name="wo-wordpress", port="http,https"]
logpath = /var/log/nginx/*access*.log
maxretry = 5

[nginx-forbidden]
enabled = true
backend = auto
filter = nginx-forbidden
action = iptables-multiport[name="nginx-forbidden", port="http,https"]
logpath = /var/log/nginx/*error*.log

[wo-wordpress-auth]
enabled = true
backend = systemd
filter = wo-wordpress-auth
action = iptables-multiport[name="wo-wordpress-auth", port="http,https"]
maxretry = 5{{/nginx}}